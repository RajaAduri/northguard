# NorthGuard integration configuration — the single environment surface.
# Copy to .env (which is gitignored) and fill in for your machine.
#
# Local OpenAI-compatible model endpoint. Also stands in for the external provider
# during testing, so all traffic stays on this machine and costs nothing per call.
# Any OpenAI-compatible server works (Ollama, LM Studio, llama.cpp, vLLM …).
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# The BACKSTOP model (E3 inspection). IMPORTANT: on a single-GPU/CPU Ollama host, use the
# SAME model as FORWARD_MODEL so Ollama keeps one model resident and never swaps between
# requests — a swap adds ~10-15s to each turn (measured: forward 20.8s → 8.0s once shared).
# Reliable placeholder handling needs ~7B (Sprint 9 A/B), so qwen2.5:7b-instruct is the
# default for both roles.
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# A second, different model — used only for the step-10 stability cross-check.
LOCAL_LLM_MODEL_ALT=gemma3:4b
# Bearer token for the endpoint. Use "not-required" for a no-auth local server.
# NEVER commit a real key — .env is gitignored for this reason.
LOCAL_LLM_KEY=not-required

# The provider forwarding model (gateway → provider stand-in). Must be ~7B to preserve
# placeholders; keep it equal to LOCAL_LLM_MODEL to avoid Ollama model swaps.
FORWARD_MODEL=qwen2.5:7b-instruct

# The E3 backstop service (the core calls this; it bridges to LOCAL_LLM_URL).
NORTHGUARD_BACKSTOP_URL=http://127.0.0.1:8078/inspect
NORTHGUARD_BACKSTOP_HEALTH_URL=http://127.0.0.1:8078/health
BACKSTOP_PORT=8078
# Bound the backstop so a slow/absent model degrades to rules-only fast (NG-4), never hangs
# the UI. NORTHGUARD_BACKSTOP_LLM_TIMEOUT = service→Ollama seconds; the core aborts its call
# to the service after NORTHGUARD_BACKSTOP_TIMEOUT_MS.
NORTHGUARD_BACKSTOP_LLM_TIMEOUT=20
NORTHGUARD_BACKSTOP_TIMEOUT_MS=12000

# The kg-gen sidecar (E2 policy extraction; also bridges to LOCAL_LLM_URL).
KG_SIDECAR_URL=http://127.0.0.1:8077
KG_SIDECAR_PORT=8077

# The pinned E7 embedding model (NG-15). Revision is pinned; the resolved commit
# the loader actually fetches is what lands in the audit record.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_MODEL_REVISION=main

# The E5 web UI dev server. Host 0.0.0.0 makes it reachable on the LAN.
WEB_PORT=5173
WEB_HOST=0.0.0.0
